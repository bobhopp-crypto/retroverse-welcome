Project retroverse_canonical_graph {
  database_type: "PostgreSQL"
  Note: "Retroverse canonical graph schema export (documentation only)."
}

// ---------------------------------------------------------------------------
// artists / tracks / albums (core canonical entities)
// ---------------------------------------------------------------------------

Table retroverse_artists {
  retroverse_artist_id text [pk, not null, note: "RVAR######"]
  canonical_artist_name text [not null]
  sort_name text
  notes text
  created_at timestamptz [not null, default: `now()`]
}

Table retroverse_eras {
  retroverse_era_id text [pk, not null, note: "RVER######"]
  start_year integer [not null]
  end_year integer [not null]
  slug text [not null, unique]
  display_name text [not null]
  summary text
  notes text
  created_at timestamptz [not null, default: `now()`]
}

Table retroverse_albums {
  retroverse_album_id text [pk, not null, note: "RVAL######"]
  canonical_album_title text [not null]
  retroverse_artist_id text [not null]
  era_id text
  release_year integer
  release_date date
  soundtrack_flag boolean [not null, default: false]
  album_type text [not null, default: 'studio', note: "studio|soundtrack|compilation|live|ep|single|other"]
  notes text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    retroverse_artist_id [name: "idx_retroverse_albums_artist"]
    era_id [name: "idx_retroverse_albums_era"]
  }
}

Table retroverse_tracks {
  retroverse_track_id text [pk, not null, note: "RVTR######"]
  canonical_title text [not null]
  retroverse_artist_id text [not null]
  retroverse_album_id text
  release_year integer
  era_id text
  notes text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    retroverse_artist_id [name: "idx_retroverse_tracks_artist"]
    retroverse_album_id [name: "idx_retroverse_tracks_album"]
    era_id [name: "idx_retroverse_tracks_era"]
  }
}

// ---------------------------------------------------------------------------
// sequencing (edition + ordered placement + album-artist roles + canonical art)
// ---------------------------------------------------------------------------

Table retroverse_album_editions {
  retroverse_album_edition_id text [pk, not null, note: "RVED######"]
  retroverse_album_id text [not null]
  edition_key text [not null]
  edition_name text [not null]
  release_date date
  release_year integer
  era_id text
  is_primary boolean [not null, default: false]
  notes text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (retroverse_album_id, edition_key) [unique]
    retroverse_album_id [name: "idx_retroverse_album_editions_album"]
    era_id [name: "idx_retroverse_album_editions_era"]
    retroverse_album_id [unique, name: "idx_retroverse_album_editions_one_primary", note: "Partial unique where is_primary = true"]
  }
}

Table retroverse_album_tracks {
  retroverse_album_track_id text [pk, not null, note: "RVAT######"]
  retroverse_album_edition_id text [not null]
  retroverse_track_id text [not null]
  disc_number integer [not null]
  track_number integer [not null]
  side_code text [note: "A-H or null"]
  side_position integer
  is_interlude boolean [not null, default: false]
  soundtrack_exclusive boolean [not null, default: false]
  notes text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (retroverse_album_edition_id, disc_number, track_number) [unique]
    retroverse_track_id [name: "idx_retroverse_album_tracks_track"]
    (retroverse_album_edition_id, side_code, side_position) [unique, name: "idx_retroverse_album_tracks_unique_side_order", note: "Partial unique where side_code and side_position are not null"]
  }
}

Table retroverse_album_artist_roles {
  retroverse_album_artist_role_id text [pk, not null, note: "RVRL######"]
  retroverse_album_id text [not null]
  retroverse_artist_id text [not null]
  relationship_role text [not null, note: "primary|soundtrack_primary|contributing|featured"]
  billing_order integer [not null, default: 1]
  notes text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (retroverse_album_id, retroverse_artist_id, relationship_role) [unique]
    (retroverse_album_id, billing_order) [name: "idx_retroverse_album_artist_roles_album"]
    retroverse_artist_id [name: "idx_retroverse_album_artist_roles_artist"]
  }
}

Table retroverse_album_artwork {
  retroverse_album_artwork_id text [pk, not null, note: "RVAW######"]
  retroverse_album_id text [not null]
  retroverse_album_edition_id text
  artwork_role text [not null, note: "primary|alternate|booklet|back"]
  is_primary boolean [not null, default: false]
  canonical_cover_path text
  cover_source text
  artwork_status text [not null, note: "missing|pending|verified|rejected"]
  width_px integer
  height_px integer
  notes text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (retroverse_album_id, artwork_role) [name: "idx_retroverse_album_artwork_album"]
    retroverse_album_edition_id [name: "idx_retroverse_album_artwork_edition"]
    (retroverse_album_id, retroverse_album_edition_id) [unique, name: "idx_retroverse_album_artwork_primary_per_edition", note: "Partial unique where is_primary = true and edition_id is not null"]
    retroverse_album_id [unique, name: "idx_retroverse_album_artwork_primary_album_level", note: "Partial unique where is_primary = true and edition_id is null"]
  }
}

// ---------------------------------------------------------------------------
// charts
// ---------------------------------------------------------------------------

Table retroverse_chart_appearances {
  retroverse_chart_id text [pk, not null, note: "RVCH######"]
  retroverse_track_id text [not null]
  chart_date date [not null]
  chart_name text [not null]
  chart_position integer [not null]
  weeks_on_chart integer
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (retroverse_track_id, chart_date) [name: "idx_retroverse_chart_appearances_track_date"]
  }
}

// ---------------------------------------------------------------------------
// media
// ---------------------------------------------------------------------------

Table retroverse_media_assets {
  retroverse_media_asset_id text [pk, not null, note: "RVMA######"]
  retroverse_track_id text [not null]
  media_type text [not null, note: "video|audio|image|other"]
  media_source text [not null]
  local_path text [not null]
  thumbnail_path text
  file_name text [not null]
  duration_seconds integer
  video_width integer
  video_height integer
  source_confidence numeric(5,4) [not null]
  is_primary boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (retroverse_track_id, media_source, local_path) [unique]
    retroverse_track_id [name: "idx_retroverse_media_assets_track"]
    (retroverse_track_id, is_primary) [name: "idx_retroverse_media_assets_primary"]
  }
}

// ---------------------------------------------------------------------------
// enrichment (measurable audio features — not canonical chart or identity)
// ---------------------------------------------------------------------------

Table retroverse_track_enrichment {
  enrichment_id text [pk, not null, note: "RVEN######"]
  retroverse_track_id text
  source_song text
  source_album text
  source_artist text
  acousticness float
  danceability float
  energy float
  valence float
  tempo float
  loudness float
  speechiness float
  instrumentalness float
  duration_ms integer
  time_signature integer
  source_album_identity text
  source_fingerprint text [not null, unique]
  enrichment_source text [not null]
  source_date date
  match_confidence numeric(6,4)
  match_method text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    retroverse_track_id [name: "idx_retroverse_track_enrichment_track"]
    source_album_identity [name: "idx_retroverse_track_enrichment_album_identity"]
    (source_artist, source_song) [name: "idx_retroverse_track_enrichment_artist_song"]
  }
}

// ---------------------------------------------------------------------------
// source matching
// ---------------------------------------------------------------------------

Table retroverse_source_matches {
  retroverse_source_match_id text [pk, not null, note: "RVSM######"]
  source text [not null]
  source_key text [not null]
  source_title text
  source_artist text
  retroverse_entity_type text [not null, note: "artist|album|track|chart|era"]
  retroverse_entity_id text [not null, note: "Polymorphic canonical ID (RVAR/RVAL/RVTR/RVCH/RVER)"]
  confidence_score numeric(5,4) [not null]
  manual_override boolean [not null, default: false]
  verified_by text
  notes text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (source, source_key, retroverse_entity_type) [unique]
    (retroverse_entity_type, retroverse_entity_id) [name: "idx_retroverse_source_matches_entity"]
    (source, source_key) [name: "idx_retroverse_source_matches_source"]
  }
}

// ---------------------------------------------------------------------------
// foreign keys
// ---------------------------------------------------------------------------

Ref: retroverse_albums.retroverse_artist_id > retroverse_artists.retroverse_artist_id
Ref: retroverse_albums.era_id > retroverse_eras.retroverse_era_id

Ref: retroverse_tracks.retroverse_artist_id > retroverse_artists.retroverse_artist_id
Ref: retroverse_tracks.retroverse_album_id > retroverse_albums.retroverse_album_id
Ref: retroverse_tracks.era_id > retroverse_eras.retroverse_era_id

Ref: retroverse_album_editions.retroverse_album_id > retroverse_albums.retroverse_album_id
Ref: retroverse_album_editions.era_id > retroverse_eras.retroverse_era_id

Ref: retroverse_album_tracks.retroverse_album_edition_id > retroverse_album_editions.retroverse_album_edition_id
Ref: retroverse_album_tracks.retroverse_track_id > retroverse_tracks.retroverse_track_id

Ref: retroverse_album_artist_roles.retroverse_album_id > retroverse_albums.retroverse_album_id
Ref: retroverse_album_artist_roles.retroverse_artist_id > retroverse_artists.retroverse_artist_id

Ref: retroverse_album_artwork.retroverse_album_id > retroverse_albums.retroverse_album_id
Ref: retroverse_album_artwork.retroverse_album_edition_id > retroverse_album_editions.retroverse_album_edition_id

Ref: retroverse_chart_appearances.retroverse_track_id > retroverse_tracks.retroverse_track_id

Ref: retroverse_track_enrichment.retroverse_track_id > retroverse_tracks.retroverse_track_id

Ref: retroverse_media_assets.retroverse_track_id > retroverse_tracks.retroverse_track_id

// Note: retroverse_source_matches intentionally uses polymorphic references,
// so retroverse_entity_id has no direct FK constraint.
