# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# large local chart exports
/exports/billboard_200/*.csv
/exports/acoustics/*.csv

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large local-only data and artwork (lives on R2/Cloudflare in production)
/public/retroverse/
/public/media-thumbnails/
/public/covers/
/data/raw/
/data/generated/
/data/diagnostics/
/data/imports/
/data/local-retroverse.db
/data/local-retroverse.db-*
/reports/

# cloudflare wrangler local dev state
/.wrangler/

# stray empty file created by an old `npm install > tsx` mistake
/tsx

